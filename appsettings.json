{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=codemetrics.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtSettings": {
  "SecretKey": "REPLACE_WITH_USER_SECRET",
  "Issuer": "CodeMetricsAPI",
  "Audience": "CodeMetricsClient",
  "ExpiryMinutes": 15
}
}
